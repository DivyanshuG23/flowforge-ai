PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# Allowed Frontend Origins for CORS (comma-separated for multiple domains)
CLIENT_ORIGIN=http://localhost:5173

# Optional Rate Limiting Configuration
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
EXECUTION_RATE_LIMIT_WINDOW_MS=60000
EXECUTION_RATE_LIMIT_MAX=30

# Optional DNS configuration override (comma-separated IP addresses)
DNS_SERVERS=

# AI Inference Provider Configuration (Server-Side Only)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
AI_ALLOWED_HOSTS=

# Optional Default AI Model Overrides
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
OPENAI_DEFAULT_MODEL=gpt-4o-mini
MISTRAL_DEFAULT_MODEL=mistral-small-latest
